{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playbook.schema.json",
  "title": "Playbook (canonical object), schema version 2",
  "description": "Validates the canonical object of a playbook: front matter fields plus `content`. See spec/playbook-format.md.",
  "type": "object",
  "required": [
    "id",
    "version",
    "last_reviewed",
    "content"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/slug"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "last_reviewed": {
      "$ref": "#/$defs/date"
    },
    "expires": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "$ref": "#/$defs/content"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^(x-)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_or_list": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        }
      ]
    },
    "text_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "source": {
      "enum": [
        "stated",
        "client-instruction",
        "prior-matter",
        "firm-default"
      ]
    },
    "firm_view": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/text"
        },
        "unless": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "guardrail_item": {
      "type": "object",
      "required": [
        "when",
        "action"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/text"
        },
        "action": {
          "enum": [
            "flag",
            "escalate",
            "stop"
          ]
        },
        "escalate_to": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "escalate"
          }
        }
      },
      "then": {
        "required": [
          "escalate_to"
        ],
        "properties": {
          "escalate_to": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "guardrail": {
      "if": {
        "type": "array"
      },
      "then": {
        "items": {
          "$ref": "#/$defs/guardrail_item"
        },
        "minItems": 1
      },
      "else": {
        "$ref": "#/$defs/guardrail_item"
      }
    },
    "issue_base": {
      "description": "Every issue field except `source`.",
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "legal",
            "commercial",
            "hybrid"
          ]
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "why": {
          "$ref": "#/$defs/text_or_list"
        },
        "triggers": {
          "$ref": "#/$defs/text_or_list"
        },
        "look_for": {
          "$ref": "#/$defs/text_or_list"
        },
        "not_when": {
          "$ref": "#/$defs/text_or_list"
        },
        "check": {
          "$ref": "#/$defs/text_or_list"
        },
        "jurisdiction_note": {
          "$ref": "#/$defs/text_or_list"
        },
        "rule": {
          "type": "string"
        },
        "market_position": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "approaches": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "firm_view": {
          "$ref": "#/$defs/firm_view"
        },
        "position": {
          "type": "string"
        },
        "acceptable": {
          "$ref": "#/$defs/text_list"
        },
        "never": {
          "$ref": "#/$defs/text_list"
        },
        "red_line": {
          "type": "boolean"
        },
        "accepts": {
          "type": "string"
        },
        "instruction": {
          "$ref": "#/$defs/text_or_list"
        },
        "guardrail": {
          "$ref": "#/$defs/guardrail"
        },
        "history": {
          "$ref": "#/$defs/text_or_list"
        },
        "note": {
          "$ref": "#/$defs/text_or_list"
        }
      },
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "commercial"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "firm_view"
          ]
        }
      }
    },
    "issue": {
      "allOf": [
        {
          "$ref": "#/$defs/issue_base"
        },
        {
          "properties": {
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "issues"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    }
  }
}
